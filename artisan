#!/usr/bin/env php
<?php

define('ENGLAI_START', microtime(true));

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

$command = $argv[1] ?? '';

if ($command === 'serve') {
    $port = '8000';
    foreach ($argv as $arg) {
        if (str_starts_with($arg, '--port=')) {
            $port = substr($arg, 7);
        }
    }

    echo "\n  \033[30;42m INFO \033[0m  Server running on [http://127.0.0.1:{$port}].  \n\n";
    echo "  Press Ctrl+C to stop the server\n\n";

    // Redirect stderr to NUL to hide PHP server logs on Windows
    passthru("php -S 127.0.0.1:{$port} router.php 2>NUL");
    exit(0);
}

echo "EnglAI adalah proyek Native PHP (bukan Laravel).\n";
echo "Kami membuatkan file helper ini agar perintah 'php artisan serve' bisa Anda gunakan untuk menjalankan server.\n";
echo "Perintah yang didukung:\n";
echo "  php artisan serve\n";
exit(0);
