APP_ENV=production
APP_DEBUG=false
APP_KEY=replace-with-at-least-32-random-characters
APP_URL=https://englai.example.com
APP_TIMEZONE=Asia/Jakarta
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=englai
DB_USER=englai_app
DB_PASS=replace-with-strong-database-password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=20
SESSION_TIMEOUT_SECONDS=28800
LIVE_QUIZ_POLL_INTERVAL_MS=1500
LIVE_QUIZ_MAX_PARTICIPANTS=40
PUBLIC_DEMO_ENABLED=true
MAINTENANCE_MODE=false
MASTERY_THRESHOLD_PERCENT=80
